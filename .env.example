# ============================================
# Evolution Manager + API + Redis — Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ============================================

# --- Evolution Manager (Nginx) ---
MANAGER_PORT=3050
NODE_ENV=production

# --- Evolution API ---
EVOLUTION_API_PORT=8080
SERVER_PORT=8080
AUTHENTICATION_API_KEY=your-api-key-here

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=evolution

# --- Redis (protegido con contraseña, solo localhost) ---
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password
CACHE_REDIS_ENABLED=true
CACHE_REDIS_PREFIX_KEY=evolution

# --- WebSocket (Evolution API) ---
WEBSOCKET_ENABLED=true
WEBSOCKET_ALLOWED_HOSTS=https://whatsapp.example.com

# --- CORS ---
CORS_ORIGIN=https://whatsapp.example.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true
